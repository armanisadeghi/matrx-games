{
  "name": "matrx-games",
  "version": "0.1.5",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "node scripts/check-matrx-packages.mjs && node scripts/check-package-twins.mjs --self-test && node scripts/check-package-twins.mjs --strict",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "type-check": "tsc --noEmit",
    "types": "npx supabase gen types typescript --project-id eddtfkgtwbyhqdgmmofi --schema public > types/database.types.ts",
    "seed-words": "dotenv -e .env.local -- tsx scripts/seed-words.ts",
    "check:matrx-packages": "node scripts/check-matrx-packages.mjs",
    "check:matrx-latest": "node scripts/check-matrx-packages.mjs",
    "sync:matrx-packages": "pnpm update -r \"@ai-matrx/*\" --latest && pnpm check:matrx-packages",
    "check:package-twins": "node scripts/check-package-twins.mjs --strict",
    "check:package-twins:self-test": "node scripts/check-package-twins.mjs --self-test"
  },
  "dependencies": {
    "@ai-matrx/agents": "latest",
    "@ai-matrx/data": "latest",
    "@ai-matrx/design-system": "latest",
    "@ai-matrx/kit": "latest",
    "@supabase/supabase-js": "^2.117.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "motion": "^12.43.0",
    "nanoid": "^5.1.16",
    "next": "16.3.6",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  }
}
